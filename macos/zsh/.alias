# SYSTEM
alias c='clear'
alias chist='history -p'
alias r='exec ${SHELL} -l'
alias x='exit'
alias b='bat'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias path='echo -e ${PATH//:/\\n}'
alias grep='grep --color'

alias aa='nvim ~/.indie-dawg-dots/macos/zsh/.alias'
alias zz='nvim ~/.indie-dawg-dots/macos/zsh/.zshrc'
alias ss='nvim ~/.secret/.alias'

# Hostname
alias host='echo $HOST'

# Machines SSH
alias odin='ssh edo@odin'
alias freya='ssh edo@freya'
alias freya-ts='ssh edo@freya-ts'
alias saga='ssh edo@saga'
alias batman='ssh edo@batman'
alias batman-ts='ssh edo@batman-ts'

alias k21='ssh edo@k21'
alias k22='ssh edo@k22'
alias k23='ssh edo@k23'
alias k24='ssh edo@k24'
alias k25='ssh edo@k25'
alias k26='ssh edo@k26'
alias k27='ssh edo@k27'
alias k28='ssh edo@k28'

# Machines SSH Tunnels
alias odin-tunnel='ssh -fN -L 4030:localhost:4030 edo@odin'
alias kill-odin-tunnel='kill $(pgrep -f "ssh -fN -L 4030")'
alias freya-tunnel='ssh -fN -L 4030:localhost:4030 edo@freya'
alias kill-freya-tunnel='kill $(pgrep -f "ssh -fN -L 4030")'

# INDIE-DAWG-DOTS
alias dots='cd ~/.indie-dawg-dots && nvim .'

# NEOVIM
alias v='nvim'
alias vv='nvim .'
alias rswap='rm -rf ~/.local/state/nvim/swap/*'

# GHOSTTY
alias gtm='$HOME/.indie-dawg-dots/macos/ghostty/ghostty-theme-menu'
alias gt='$HOME/.config/bin/ghostty-theme-switcher'
alias gtheme='gt'
alias gbg='$HOME/.config/bin/ghostty-bg-picker'
alias ot='$HOME/.indie-dawg-dots/macos/ghostty/ghostty-opacity-toggle'

# NETWORK PRIORITY
alias isp='curl ipinfo.io | grep org'

# NODE_MODULES
alias lsnodemodules="find . -name node_modules -type d -prune"
alias rmnodemodules="find . -name node_modules -type d -prune -exec rm -rf {} +"

# GIT
alias gll="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gsl="git stash list"
alias gsc="git stash clear"
alias gs="git status"
alias gd="git diff"
alias gb="git branch"
alias gfo="git fetch origin"
alias gcp="git cherry-pick"
alias lg="lazygit"
alias gwl="git worktree list"
alias dlb="git branch | grep -v \* | xargs git branch -D"
alias gloc="git ls-files | grep -v -E '(pnpm-lock\.yaml|package-lock\.json)' | xargs wc -l"
alias grc="git rebase --continue"

# NPM
alias npmg='npm list -g --depth 0'

# PNPM
alias pdd='pnpm dev:down'
alias pdu='pnpm dev:up'
alias pdc='pnpm dev:clean'

# UTILS
alias mb='cmatrix -C blue'
alias m='cmatrix'

# K8s
alias k='kubectl'

# PYTHON
alias pyac='source .venv/bin/activate'
alias pyde='deactivate'
alias pyvenv='echo $VIRTUAL_ENV'

# AWS
alias aws-whoami='aws sts get-caller-identity'

# MULTIVERSE
alias mm='cd ~/Multiverse && nvim .'

# DOCKER
alias dps='docker ps --format "table {{.ID}}\t{{.Names}}\t{{.RunningFor}}\t{{.Status}}"'
alias dpa='docker ps -a --format "table {{.ID}}\t{{.Names}}\t{{.RunningFor}}\t{{.Status}}"'
alias dcd='docker compose -f docker-compose.dev.yaml down'
alias dcu='docker compose -f docker-compose.dev.yaml up -d'
alias di='docker images'
alias ddf='docker system df'

export VFORMAT="ID\t{{.ID}}\nNAME\t{{.Names}}\nIMAGE\t{{.Image}}\nPORTS\t{{.Ports}}\nCOMMAND\t{{.Command}}\nCREATED\t{{.CreatedAt}}\nSTATUS\t{{.Status}}\n"
alias dpsv='docker ps --format="$VFORMAT"'
alias dpav='docker ps -a --format="$VFORMAT"'

# VIRT MANAGER
alias vm='virt-manager & disown'

# SPEEDTEST (built into macOS)
alias speed='networkQuality -v'

# MACHINES
alias ssh='TERM=xterm-256color ssh'
alias killt='lsof -ti:25060 | xargs kill -9'

alias wakerubik='wakeonlan b4:2e:99:3d:2f:40'

# UTILS IP STUFF
alias myip='dig +short myip.opendns.com @resolver1.opendns.com'
alias myiplocation='curl https://ipinfo.io'

# Standard eza aliases
alias ls='eza --icons --color=always --group-directories-first'
alias l='eza -F --icons --color=always --group-directories-first'
alias ll='eza -alh --icons --color=always --group-directories-first'
alias la='eza -a --icons --color=always --group-directories-first'
alias lt='eza --tree --icons --color=always --group-directories-first'
alias l.='eza -a | grep "^\."'

# Enhanced directory listing with git
alias lsa='eza -lah --icons --color=always --group-directories-first --git'
alias lst='eza -lah --icons --color=always --group-directories-first --git --tree --level=2'
alias lsg='eza -alh --icons --color=always --group-directories-first --git'

# Time-based listing
alias lsnew='eza -alh --icons --color=always --group-directories-first --sort=created'
alias lsold='eza -alh --icons --color=always --group-directories-first --sort=created --reverse'
alias lsmod='eza -alh --icons --color=always --group-directories-first --sort=modified'

# Size-based listing
alias lsize='eza -alh --icons --color=always --group-directories-first --sort=size --reverse'

# SPOTIFY
alias sp='TERM=xterm-256color spotify_player'

## 1PASSWORD
# Secrets live in 1Password; ~/.secret/*.tpl hold only op:// references.
# The desktop app integration unlocks op with Touch ID, so no session handling.
# opr <cmd> runs a command with every secret in ~/.secret/.env.tpl.
opr() {
  op run --env-file="$HOME/.secret/.env.tpl" -- "$@"
}

## CLAUDE CODE
alias cc="claude --dangerously-skip-permissions"
alias ccusage="npx ccusage daily"

# GLM coder (z.ai) — Option A of the "Opus architect / GLM coder" workflow.
# Architect/plan in a normal `cc` (Opus) session, then implement here on GLM.
# ZAI_API_KEY is injected from 1Password (vault odin) by op run.
glm() {
  ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
  ANTHROPIC_AUTH_TOKEN="op://odin/ZAI_API_KEY/credential" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="GLM-5.2" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="GLM-5.2" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="GLM-4.5-Air" \
  API_TIMEOUT_MS="3000000" \
  op run --no-masking -- claude --dangerously-skip-permissions "$@"
}

# DeepSeek coder — same pattern as glm(), via DeepSeek's native Anthropic-compatible endpoint.
# deepseek-v4-pro for Opus/Sonnet tiers, deepseek-v4-flash (= deepseek-chat) for Haiku.
# DEEPSEEK_API_KEY is injected from 1Password (vault odin) by op run.
dsk() {
  ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic" \
  ANTHROPIC_AUTH_TOKEN="op://odin/DEEPSEEK_API_KEY/credential" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-pro" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-pro" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash" \
  API_TIMEOUT_MS="3000000" \
  op run --no-masking -- claude --dangerously-skip-permissions "$@"
}

# CODEX
alias cco="codex --sandbox danger-full-access --ask-for-approval never"

# TMUX
alias t='tmux'
alias tc='v ~/.tmux.conf'
alias tl='tmux ls'
alias tll="tmux list-sessions -F '#{session_id} #{session_name}'"
alias tk='tmux kill-session -t'
alias ta='tmux attach -t'
alias tn='tmux new-session -A -s'
alias tam='ta MULTIVERSE'

# ZELLIJ
alias z='zellij'
alias zn='zellij --session'
alias zl='zellij list-sessions'
alias za='zellij attach'
alias zd='zellij delete-session'
alias zt='$HOME/.indie-dawg-dots/zellij/switch-theme.sh'
alias zam='za MULTIVERSE'

# YAZI
alias y='yazi'

# FASTFETCH
alias ff='fastfetch'
