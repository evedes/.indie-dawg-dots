## 1PASSWORD SECRETS
# Secrets live in 1Password (vault "odin"); ~/.secret/*.env.tpl hold only op:// references.
# The session token is kept in an unexported shell variable, so child processes
# (including Claude Code) can't reuse the 1Password session.
typeset -g _op_session=""
_op_ensure() {
  op whoami --session "$_op_session" &>/dev/null && return 0
  _op_session=$(op signin --raw) || return 1
}
# opr <cmd> — run a command with all secrets from ~/.secret/.env.tpl
opr() {
  _op_ensure && op run --session "$_op_session" --env-file="$HOME/.secret/.env.tpl" -- "$@"
}
# Claude Code only gets ~/.secret/claude.env.tpl (the MCP token). No masking:
# it would sit between claude and the TTY.
_claude_op() {
  _op_ensure && op run --session "$_op_session" --no-masking \
    --env-file="$HOME/.secret/claude.env.tpl" -- claude --dangerously-skip-permissions "$@"
}

## CLAUDE CODE
unalias cc 2>/dev/null
cc() { _claude_op "$@"; }

# GLM coder (z.ai) — Option A of the "Opus architect / GLM coder" workflow.
# Architect/plan in a normal `cc` (Opus) session, then implement here on GLM.
# The op:// reference is resolved by `op run` inside _claude_op.
glm() {
  ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
  ANTHROPIC_AUTH_TOKEN="op://odin/ZAI_API_KEY/credential" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="GLM-5.3" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="GLM-5.3" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="GLM-4.5-Air" \
  API_TIMEOUT_MS="3000000" \
  _claude_op "$@"
}

# DeepSeek coder — same pattern as glm(), via DeepSeek's native Anthropic-compatible endpoint.
# deepseek-v4-pro for Opus/Sonnet tiers, deepseek-v4-flash (= deepseek-chat) for Haiku.
dsk() {
  ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic" \
  ANTHROPIC_AUTH_TOKEN="op://odin/DEEPSEEK_API_KEY/credential" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-pro" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-pro" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash" \
  API_TIMEOUT_MS="3000000" \
  _claude_op "$@"
}

# SOL coder (OpenAI Codex sub) — same pattern as glm(), but via a local
# Anthropic→OpenAI translating proxy (OpenAI has no native Anthropic endpoint).
# Requires: raine/claude-code-proxy installed, one-time login:
#   claude-code-proxy codex auth login   (reuses Codex CLI OAuth)
sol() {
  if ! command -v claude-code-proxy >/dev/null; then
    print -u2 "sol: claude-code-proxy not installed — see https://github.com/raine/claude-code-proxy"
    return 1
  fi
  if ! pgrep -fx 'claude-code-proxy serve' >/dev/null; then
    claude-code-proxy serve &>/dev/null &
    sleep 1
  fi
  ANTHROPIC_BASE_URL="http://127.0.0.1:18765" \
  ANTHROPIC_AUTH_TOKEN="unused" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="gpt-5.6-sol" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="gpt-5.6-sol" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="gpt-5.6-luna" \
  API_TIMEOUT_MS="3000000" \
  _claude_op "$@"
}

