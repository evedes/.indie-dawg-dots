#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=$($root/bin/profile-name)

if [[ "$profile" == odin ]]; then
	systemctl --user restart quickshell.service awww-daemon.service
else
	killall quickshell awww-daemon nextcloud-desktop 2>/dev/null || true
	sleep 0.2
	quickshell -p "$HOME/.quickshell" &
	awww-daemon &
	nextcloud-desktop &
	vicinae server --replace &
fi
