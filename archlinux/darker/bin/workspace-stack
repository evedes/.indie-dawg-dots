#!/usr/bin/env bash
set -euo pipefail

# This file intentionally matches odin/bin/workspace-stack. Each machine keeps
# its own bin directory, while workspace names remain local to monitor outputs.

die() { printf 'workspace-stack: %s\n' "$*" >&2; exit 1; }

rename_workspace() {
	local id=$1 name=$2
	hyprctl dispatch "hl.dsp.workspace.rename({ workspace = $id, name = [[$name]] })" >/dev/null
}

workspace_rows() {
	hyprctl -j workspaces | jq -r '.[] | select(.name | startswith("special:") | not) | [.monitor, (.id | tostring), .name] | @tsv'
}

normalize_monitor() {
	local monitor=$1 id name suffix sort_key pos=0
	local -a rows=() ids=()
	while IFS=$'\t' read -r id name; do
		[[ -n ${id:-} ]] || continue
		if [[ $name == "$monitor:"* ]]; then
			suffix=${name#"$monitor:"}
			[[ $suffix =~ ^[0-9]+$ ]] && sort_key=$suffix || sort_key=$((1000000 + pos))
		else
			sort_key=$((1000000 + pos))
		fi
		rows+=("$(printf '%010d\t%s' "$sort_key" "$id")")
		pos=$((pos + 1))
	done < <(workspace_rows | awk -F '\t' -v monitor="$monitor" '$1 == monitor { print $2 "\t" $3 }')
	((${#rows[@]})) || return 0
	mapfile -t ids < <(printf '%s\n' "${rows[@]}" | sort -n -k1,1 | cut -f2)
	for id in "${ids[@]}"; do
		rename_workspace "$id" "__workspace_stack_${monitor}_${id}"
	done
	pos=1
	for id in "${ids[@]}"; do
		rename_workspace "$id" "${monitor}:${pos}"
		pos=$((pos + 1))
	done
}

normalize_all() {
	local monitor
	while IFS= read -r monitor; do [[ -n $monitor ]] && normalize_monitor "$monitor"; done < <(hyprctl -j monitors | jq -r '.[].name')
}

insert_top() {
	local monitor=$1 id pos=2
	local -a ids=()
	while IFS= read -r id; do [[ -n ${id:-} ]] && ids+=("$id"); done < <(
		workspace_rows \
			| awk -F '\t' -v monitor="$monitor" '$1 == monitor { count = split($3, part, ":"); print part[count] "\t" $2 }' \
			| sort -n -k1,1 \
			| cut -f2
	)
	for id in "${ids[@]}"; do
		rename_workspace "$id" "__workspace_stack_${monitor}_${id}"
	done
	for id in "${ids[@]}"; do
		rename_workspace "$id" "${monitor}:${pos}"
		pos=$((pos + 1))
	done
}

[[ $# -ge 1 ]] || die "usage: workspace-stack init | {focus|move} {up|down}"
if [[ $1 == init ]]; then normalize_all; exit 0; fi
[[ $# == 2 ]] || die "usage: workspace-stack {focus|move} {up|down}"
action=$1 direction=$2
[[ $action == focus || $action == move ]] || die "unknown action: $action"
[[ $direction == up || $direction == down ]] || die "unknown direction: $direction"
read -r active_id monitor < <(hyprctl -j activeworkspace | jq -r '[.id, .monitor] | @tsv')
[[ -n ${monitor:-} ]] || die "could not determine the focused monitor"
normalize_monitor "$monitor"
name=$(hyprctl -j workspaces | jq -r --argjson id "$active_id" '.[] | select(.id == $id) | .name')
index=${name#"$monitor:"}
[[ $index =~ ^[0-9]+$ ]] || die "could not normalize workspace $active_id"
if [[ $direction == up && $index -eq 1 ]]; then
	[[ $action == focus ]] && exit 0
	insert_top "$monitor"
	target=1
elif [[ $direction == up ]]; then target=$((index - 1))
else target=$((index + 1))
fi
target_name="${monitor}:${target}"
existing_id=$(hyprctl -j workspaces | jq -r --arg name "$target_name" '.[] | select(.name == $name) | .id')
if [[ -n $existing_id ]]; then
	selector="name:${target_name}"
else
	# Create new tail workspaces with increasing positive IDs so slidevert uses
	# the visual stack direction, then apply the display-scoped name.
	monitor_id=$(hyprctl -j monitors | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .id')
	[[ $monitor_id =~ ^[0-9]+$ ]] || die "could not determine ID for monitor $monitor"
	workspace_id=$(((monitor_id + 1) * 1000 + target))
	occupied=$(hyprctl -j workspaces | jq -r --argjson id "$workspace_id" '.[] | select(.id == $id) | .name')
	[[ -z $occupied ]] || die "workspace ID $workspace_id is already used by $occupied"
	selector=$workspace_id
fi
if [[ $action == focus ]]; then
	hyprctl dispatch "hl.dsp.focus({ workspace = [[$selector]] })" >/dev/null
else
	hyprctl dispatch "hl.dsp.window.move({ workspace = [[$selector]] })" >/dev/null
fi
[[ -n $existing_id ]] || rename_workspace "$workspace_id" "$target_name"
