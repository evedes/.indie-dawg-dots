#!/bin/bash
killall quickshell 2>/dev/null
killall awww-daemon 2>/dev/null
# Quickshell is the notification daemon; stop any legacy mako instance before
# restarting it so Quickshell can claim org.freedesktop.Notifications.
killall mako 2>/dev/null
killall nextcloud-desktop 2>/dev/null

sleep 0.2
quickshell &
awww-daemon &
nextcloud-desktop &
vicinae server --replace &
