#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Take Screenshot: Region to Clipboard
# @vicinae.mode silent
# @vicinae.icon 📋
# @vicinae.keywords ["screenshot", "capture", "screen", "region", "selection", "clipboard", "copy", "hyprshot"]
