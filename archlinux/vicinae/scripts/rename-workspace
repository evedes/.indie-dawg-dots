#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Rename Workspace
# @vicinae.mode silent
# @vicinae.icon 🏷️
# @vicinae.keywords ["workspace", "rename", "name", "label", "hyprland"]
# @vicinae.description Give the active workspace a custom name (leave empty to clear)

# Release the launcher's keyboard focus before opening the name dialog.
vicinae close
exec quickshell ipc -p "$HOME/.quickshell" call workspaceRename open
